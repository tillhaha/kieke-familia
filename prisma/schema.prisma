// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  passwordHash  String?
  active        Boolean   @default(true)
  accounts      Account[]
  sessions      Session[]
  
  familyId      String?
  family        Family?   @relation(fields: [familyId], references: [id])
  
  role          Role      @default(MEMBER)
  
  workLocations WorkLocation[]
  activities    Activity[]
  travels       Travel[]
  calendarSyncs CalendarSync[]
  taskAssignments    TaskAssignee[]
  apiTokens     ApiToken[]
  personalTodos PersonalTodo[]
  personalProfile PersonalProfile?
  personalCategories PersonalCategory[]
}

// Personal bearer token for the MCP endpoint (/api/mcp). Only the SHA-256
// hash is stored; the plain token is shown once when created.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

enum Role {
  ADMIN
  PARENT
  MEMBER
}

model Family {
  id               String            @id @default(cuid())
  name             String
  city             String?
  joinCode         String?           @unique
  // Optional modules (Settings → Family → Features). Existing families keep them on;
  // families created in onboarding start with both off.
  heatingEnabled   Boolean           @default(true)
  custodyEnabled   Boolean           @default(true)
  calendarTitle    String? // label of the calendar link in the week planner
  users            User[]
  birthdays        Birthday[]
  dayPlans         DayPlan[]
  custodySchedule  CustodySchedule[]
  meals            Meal[]

  shoppingCategories ShoppingCategory[]
  shoppingItems      ShoppingItem[]
  shoppingMemory     ShoppingItemMemory[]
  shoppingTagMemory  ShoppingItemTagMemory[]
  shoppingBlacklist  ShoppingBlacklist[]
  tasks              Task[]
  importedCalendars  ImportedCalendar[]
  homematic          HomematicConnection?
  heatingAutomation  HeatingAutomation?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum WorkLocationType {
  OFFICE
  HOME
}

model WorkLocation {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  location  WorkLocationType

  @@unique([date, userId])
}

model Activity {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Birthday {
  id       String @id @default(cuid())
  name     String
  month    Int
  day      Int
  year     Int?
  familyId String
  family   Family @relation(fields: [familyId], references: [id])
}

model Travel {
  id          String   @id @default(cuid())
  destination String
  startDate   DateTime
  endDate     DateTime
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model CalendarSync {
  id         String  @id @default(cuid())
  userId     String
  calendarId String
  name       String
  color      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId])
}

model ImportedCalendar {
  id        String   @id @default(cuid())
  familyId  String
  url       String   @db.Text
  name      String
  color     String   @default("#d8ead8")
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model DayPlan {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  note           String?
  lunch          String?
  lunchNote      String?
  dinner         String?
  dinnerNote     String?
  lunchMealId    String?
  lunchMeal      Meal?   @relation("LunchMeal",  fields: [lunchMealId],  references: [id], onDelete: SetNull)
  dinnerMealId   String?
  dinnerMeal     Meal?   @relation("DinnerMeal", fields: [dinnerMealId], references: [id], onDelete: SetNull)
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id])

  @@unique([date, familyId])
}

enum MealType {
  Meal
  Snack
  Drink
  Baked
  Aufstrich
}

enum Diet {
  Vegetarian
  Meat
  Fish
}

model Meal {
  id             String   @id @default(cuid())
  name           String
  mealType       MealType @default(Meal)
  diet           Diet     @default(Meat)
  notes          String?
  servings       Int      @default(2)
  officeFriendly Boolean  @default(false)
  thirtyMinute   Boolean  @default(false)
  favorite       Boolean  @default(false)
  ingredients    String[]
  steps          String[]
  imageUrl       String?
  source         String?
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id])
  createdAt      DateTime @default(now())

  lunchDayPlans  DayPlan[] @relation("LunchMeal")
  dinnerDayPlans DayPlan[] @relation("DinnerMeal")
}

enum CustodyLocation {
  WITH_US
  WITH_MONA
}

model CustodySchedule {
  id         String          @id @default(cuid())
  date       DateTime        @db.Date
  personName String
  location   CustodyLocation
  familyId   String
  family     Family          @relation(fields: [familyId], references: [id])

  @@unique([date, personName, familyId])
}

model ShoppingCategory {
  id       String  @id @default(cuid())
  familyId String
  family   Family  @relation(fields: [familyId], references: [id])
  name     String
  order    Int     @default(0)

  items    ShoppingItem[]
  memories ShoppingItemMemory[]

  @@unique([familyId, name])
  @@index([familyId])
}

model ShoppingItem {
  id         String            @id @default(cuid())
  familyId   String
  family     Family            @relation(fields: [familyId], references: [id])
  name       String
  quantity   String?
  note       String? // e.g. which recipes need it ("Lasagne, Curry"), set by "Add to shopping list"
  categoryId String?
  category   ShoppingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       String[]          @default([])
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  @@index([familyId])
}

model ShoppingItemMemory {
  id         String           @id @default(cuid())
  familyId   String
  family     Family           @relation(fields: [familyId], references: [id])
  itemName   String
  categoryId String
  category   ShoppingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([familyId, itemName])
}

// Remembered tags per item name, applied by default when the item is added again
model ShoppingItemTagMemory {
  id       String   @id @default(cuid())
  familyId String
  family   Family   @relation(fields: [familyId], references: [id])
  itemName String
  tags     String[]

  @@unique([familyId, itemName])
}

model ShoppingBlacklist {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id])
  term     String

  @@unique([familyId, term])
  @@index([familyId])
}

model Task {
  id          String         @id @default(cuid())
  familyId    String
  family      Family         @relation(fields: [familyId], references: [id])
  name        String
  description String?
  dueDate     DateTime       @db.Date
  done        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assignees   TaskAssignee[]

  @@index([familyId])
}

model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

// Private todo list per user, filled by the "Gedanken" assistant which splits
// free-text brain dumps into categorised items. Never visible to other family
// members — every query must filter by userId.
model PersonalTodo {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  note      String?
  category  String
  dueDate   DateTime? @db.Date
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, done])
}

// Private free-text "About me" used as life context for the thoughts assistant
// (and exposed to the owner's own MCP clients). Kept in its own table so it
// can never leak through queries that include family members' User rows.
// Always scope by userId.
model PersonalProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  updatedAt DateTime @updatedAt
}

// The user's own categories/projects for the private todo list. PersonalTodo
// stores the category by name; rows here add an optional description that
// tells the thoughts assistant what belongs in it, and keep empty categories
// around. Names are unique per user (compared case-insensitively in code).
model PersonalCategory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@unique([userId, name])
}

// Homematic IP cloud connection (one Access Point per family). While pairing,
// pairingDeviceId is set and authToken is null; once the blue button on the
// Access Point is pressed the token is stored and pairingDeviceId cleared.
// authToken grants control over the family's heating: never send it to the browser.
model HomematicConnection {
  id              String   @id @default(cuid())
  familyId        String   @unique
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  accessPointId   String   // SGTIN, 24 hex chars, no dashes, upper case
  restUrl         String   // regional cloud host from lookup.homematic.com
  authToken       String?
  pairingDeviceId String?
  pairingStarted  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Smart heating schedule: each morning, lower rooms whose people aren't home today
// (work location / custody from the week planner). One row per family.
model HeatingAutomation {
  id              String    @id @default(cuid())
  familyId        String    @unique
  family          Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(false)
  baseTemperature Float     @default(18)
  time            String    @default("08:00") // "HH:MM" local time
  timeZone        String    @default("Europe/Berlin")
  rules           Json      @default("[]") // AutomationRule[] — see src/lib/homematic/automation.ts
  lastRunDate     String? // "YYYY-MM-DD" local date of the last scheduled run (claims the day)
  lastRunAt       DateTime?
  lastRunLog      Json? // AutomationResult[] of the last run (scheduled or manual)
  updatedAt       DateTime  @updatedAt
}
